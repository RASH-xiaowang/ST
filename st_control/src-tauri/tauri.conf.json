{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "ST Control",
  "version": "1.0.0",
  "identifier": "com.st.control",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "features": ["onnx-ocr", "local-stt"]
  },
  "app": {
    "windows": [
      {
        "title": "ST 控制台",
        "width": 1600,
        "height": 1000,
        "minWidth": 1600,
        "minHeight": 1000,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#f2f7f4"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://127.0.0.1:*; media-src 'self' blob: https: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:* https:; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/key/win32/x64/wx_key.dll",
      "resources/hook/win32/x64/img_helper.dll",
      "resources/origin/wechat-cdn-poc.exe",
      "resources/origin/wxcdn_origin_bridge.dll",
      "resources/runtime/win32/msvcp140.dll",
      "resources/runtime/win32/msvcp140_1.dll",
      "resources/runtime/win32/vcruntime140.dll",
      "resources/runtime/win32/vcruntime140_1.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
